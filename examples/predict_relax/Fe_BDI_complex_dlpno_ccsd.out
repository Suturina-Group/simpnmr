NAME = Fe_BDI_complex_dlpno_ccsd.inp
|  1> # Fe2+ neutral BDI-THF complex hypefine tensor calculation
|  2> #
|  3> # Non-relativistic calculation
|  4> #
|  5> # Geometry taken from Ernest's optimisation at the B3LYP/def-2SVP level
|  6> #
|  7> # Cannot run a DLPNO-HFC2 (DLPNO-CCSD-F12 with "default 2" parameters, Saitow and 
|  8> # Neese, J. Chem. Phys., 2018, 149, 034104) calculation since CABS basis sets are 
|  9> # undefined for Fe.
| 10> #
| 11> # Charge: 0
| 12> # Multiplicity: 2S + 1 = 5, with S = 2
| 13> # 
| 14> #
| 15> ! DLPNO-CCSD def2-TZVPP AUTOAUX TightSCF RI-SOMF(1X)
| 16> 
| 17> %pal nprocs 16 end
| 18> 
| 19> %maxcore 4800
| 20> 
| 21> %mdci
| 22>    TCutPNO    1e-6
| 23>    TCutPairs  1e-3
| 24>    TCutMKN    1e-3
| 25> end
| 26> 
| 27> %output
| 28>    PrintLevel Mini
| 29> end
