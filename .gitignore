# ============================================================================
# Python artifacts
# Generated by the interpreter; never versioned.
# ============================================================================
*.pyc
__pycache__/
*.pyo
*.pyd
*egg*
*.egg-info/

# ============================================================================
# Pytest cache
# Generated by pytest; never versioned.
# ============================================================================
.pytest_cache/


# ============================================================================
# macOS system files
# Local filesystem metadata; safe to ignore globally.
# ============================================================================
.DS_Store
**/.DS_Store


# ============================================================================
# Example pipeline outputs
# These directories contain generated data from example workflows.
# Do not version them.
#
# Pattern notes:
#   - `examples/**/X/` matches X at any depth under examples/
#   - Trailing slash ensures only directories are ignored.
# ============================================================================
examples/**/SIMULATIONS/

# ============================================================================
# Generated test artefacts
# Produced by integration tests; do not version.
# ============================================================================
tests/data/pipelines/pcs_isosurface/csv_susceptibility_dyl1/pcs_isosurface_*.cube
tests/data/pipelines/pcs_isosurface/nevpt2_susceptibility_p3fecl/pcs_isosurface_*.cube
